# Copy to .env. Keep .env and keys private; this blank template can be committed.
# Without this key, Receipt runs its visibly labelled synthetic DEMO path.
QLOO_API_KEY=
# Leave disabled until a complete, comparable city-only baseline is verified live.
QLOO_BASELINE_VERIFIED=0
RECEIPT_REFERENCE_PANEL=1
# Optional live model adapter. Keep disabled until API spending is approved.
OPENAI_API_KEY=
RECEIPT_LLM_MODEL=
RECEIPT_ALLOW_LLM_CALLS=0
# Per-process ceilings; set persistent billing limits at the provider too.
RECEIPT_LLM_DAILY_CALLS=20
RECEIPT_QLOO_DAILY_CALLS=1500
